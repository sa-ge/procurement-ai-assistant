# LLM — provider: openai | anthropic | google_genai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# Optional: throttle LLM calls for free-tier quotas (e.g. Gemini free tier = 5/min)
# LLM_REQUESTS_PER_MINUTE=4
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=procurement
MONGO_COLLECTION=purchases
